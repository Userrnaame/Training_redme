                        <p class="contact-label">Hubungi Saya</p>
                        <a href="mailto:halo@namakamu.com" class="contact-email">halo@namakamu.com</a>
                    </div>
                    <div class="contact-info-block">
                        <p class="contact-label">Lokasi</p>
                        <p class="contact-text">Jakarta, Indonesia<br>Tersedia untuk seluruh dunia.</p>
                    </div>
                    <div class="contact-info-block">
                        <p class="contact-label" style="margin-bottom: 1rem;">Sosial Media</p>
                        <div class="contact-social">
                            <a href="#"><i class="fab fa-instagram"></i></a>
